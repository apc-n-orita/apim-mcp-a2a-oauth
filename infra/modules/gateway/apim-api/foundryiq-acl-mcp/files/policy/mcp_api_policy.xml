<!--
    - Policies are applied in the order they appear.
    - Position <base/> inside a section to inherit policies from the outer scope.
    - Comments within policies are not preserved.
-->
<policies>
	<inbound>
		<base />
		<!-- 呼び出し元(エージェント/クライアント)が、ACL評価対象のユーザー本人としての
             search.azure.com スコープのトークンを持っていることを検証する。
             これは Function 呼び出しの認可であると同時に、そのままACL用のユーザー識別にもなる。 -->
		<validate-azure-ad-token tenant-id="{{EntraIDTenantId}}" header-name="Authorization" output-token-variable-name="jwt" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized. Access token is missing or invalid">
			<audiences>
				<audience>https://search.azure.com/</audience>
			</audiences>
		</validate-azure-ad-token>
		<!--
      Azure AI Content Safety によるリクエストの検査 (トークン検証の後に実行し、未認証のリクエストでは呼ばない)。
      有害コンテンツ (Hate / SelfHarm / Sexual / Violence) とプロンプト攻撃 (shield-prompt) を検出する。
      検出時は APIM が 403 を返す。threshold は 0 (最も厳しい) 〜 7 (最も緩い)。重大度が threshold 以上でブロックされる
      (EightSeverityLevels では 0〜7 の 8 段階)。要素は公式ドキュメントの順序で並べること。
      backend-id は terraform の templatefile で、変数 content_safety_backend_name を埋め込む。
      PII / Indirect Attack / Task Adherence はこのポリシーの対象外。
    -->
		<llm-content-safety backend-id="${content_safety_backend_name}" shield-prompt="true">
			<categories output-type="EightSeverityLevels">
				<category name="Hate" threshold="4" />
				<category name="SelfHarm" threshold="4" />
				<category name="Sexual" threshold="4" />
				<category name="Violence" threshold="4" />
			</categories>
		</llm-content-safety>
		<!-- 検証済みの呼び出し元トークンを、AI Search の ACL 評価用ヘッダーとしてそのまま引き継ぐ -->
		<set-header name="x-ms-query-source-authorization" exists-action="override">
			<value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
		</set-header>
		<authentication-managed-identity resource="{{oauth-app-id}}" output-token-variable-name="msi-access-token" ignore-error="false" />
		<set-header name="Authorization" exists-action="override">
			<value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
		</set-header>
		<set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>
