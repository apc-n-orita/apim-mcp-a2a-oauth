          "value": "${subscription_id}"
        },
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${am_ds}"
        },
        "definition": "",
        "description": "Subscription of the Application Insights",
        "includeAll": false,
        "label": "Subscription",
        "name": "sub",
        "options": [],
        "query": {
          "grafanaTemplateVariableFn": {
            "kind": "SubscriptionsQuery",
