        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Interactive table listing recent mcp operations with timestamp, agent name, duration, and token usage. Click any row to drill down into detailed trace information for that specific operation.",
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "custom": {
                "align": "auto",
                "cellOptions": {
                  "type": "auto"
                },
                "footer": {
                  "reducers": []
                },
                "inspect": false
              },
              "links": [
                {
                  "targetBlank": false,
                  "title": "Open trace with trace Id \"$${__data.fields[TraceId]}\"",
                  "url": "/d/$${__dashboard.uid}/agent-framework?var-mcpTraceId=$${__data.fields[TraceId]}"
                }
              ],
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "red",
                    "value": 80
                  }
                ]
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "timestamp"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 209
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "duration",
                  "scope": "series"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "ms"
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 16
          },
          "id": 26,
          "options": {
            "cellHeight": "sm",
            "enablePagination": true,
            "showHeader": true,
            "sortBy": [
              {
                "desc": false,
                "displayName": "what"
              }
            ]
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let MCPNames = dynamic([$MCPName]);\r\nrequests\r\n| where cloud_RoleName == \"agentsv2\" and success == false\r\n| project timestamp, mcp = \"toolbox\", src = \"foundry\",\r\n          what = name,\r\n          detail = strcat(\"resultCode=\", resultCode,\r\n                          \" | error.type=\", tostring(customDimensions[\"error.type\"]),\r\n                          \" | rpc.response.status_code=\", tostring(customDimensions[\"rpc.response.status_code\"])),\r\n                          duration, TraceId=operation_Id \r\n| where array_length(MCPNames) > 0\r\n| where mcp in (MCPNames)\r\n| limit 20",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "logs",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            },
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let MCPNames = dynamic([$MCPName]);\r\nlet spans = dependencies\r\n  | where name == \"foundryiq_knowledge_retrieve\"\r\n  | project span_id = id, duration_ms = round(duration);\r\nunion exceptions, traces\r\n| where (itemType == \"exception\" and outerMessage == \"Knowledge retrieval failed.\")\r\n     or (itemType == \"trace\" and message == \"Knowledge base activity reported a problem.\")\r\n| extend reason_ = tostring(customDimensions[\"reason\"]),\r\n         activity_kind_ = tostring(customDimensions[\"activity_kind\"]),\r\n         activity_error_ = tostring(customDimensions[\"activity_error\"]),\r\n         activity_warning_ = tostring(customDimensions[\"activity_warning\"])\r\n| join kind=leftouter spans on $left.operation_ParentId == $right.span_id\r\n| project timestamp, mcp = \"foundryiq-acl-mcp\", src = \"function\",\r\n          what = coalesce(outerMessage, message),\r\n          detail = strcat(\"kb=\", tostring(customDimensions[\"kb\"]),\r\n                          \" | error_type=\", tostring(customDimensions[\"error_type\"]),\r\n                          \" | status_code=\", tostring(customDimensions[\"status_code\"]),\r\n                          iff(isnotempty(reason_), strcat(\" | reason=\", reason_), \"\"),\r\n                          iff(isnotempty(activity_kind_), strcat(\" | activity_kind=\", activity_kind_), \"\"),\r\n                          iff(isnotempty(activity_error_), strcat(\" | activity_error=\", activity_error_), \"\"),\r\n                          iff(isnotempty(activity_warning_), strcat(\" | activity_warning=\", activity_warning_), \"\")),\r\n          duration=duration_ms, TraceId = operation_Id\r\n| where array_length(MCPNames) > 0\r\n| where mcp in (MCPNames)\r\n| order by timestamp desc\r\n| limit 20",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "logs",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "B"
            },
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let MCPNames = dynamic([$MCPName]);\r\ntraces\r\n| where cloud_RoleName contains \"la-mcp\"\r\n| where tostring(customDimensions[\"Category\"]) == \"Workflow.Operations.Runs\"\r\n| where tostring(customDimensions[\"EventName\"]) == \"WorkflowRunEnd\"\r\n| extend p = parse_json(tostring(customDimensions[\"prop__properties\"]))\r\n| where tostring(p.status) != \"Succeeded\"\r\n| project timestamp, mcp = cloud_RoleName, src = \"workflow-run\",\r\n          what = tostring(parse_json(tostring(customDimensions[\"resource\"])).workflowName),\r\n          detail = strcat(tostring(p.status), \" \", substring(tostring(p.error), 0, 120)),\r\n          duration = todouble(customDimensions[\"prop__durationInMilliseconds\"]),\r\n          TraceId = operation_Id\r\n| where array_length(MCPNames) > 0\r\n| where mcp in (MCPNames)\r\n| order by timestamp desc\r\n| limit 20",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "logs",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "C"
            }
          ],
          "title": "Recent Errors",
          "transformations": [
            {
              "id": "merge",
              "options": {}
            }
          ],
          "type": "table"
        }
      ],
