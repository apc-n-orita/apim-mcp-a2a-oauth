        "sort": 5,
        "type": "query"
      },
      {
        "current": {
          "text": "${resource_group_name}",
          "value": "${resource_group_name}"
        },
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${am_ds}"
        },
        "definition": "",
        "label": "Resource Group",
        "name": "rg",
        "options": [],
        "query": {
          "azureLogAnalytics": {
            "query": "",
            "resources": []
          },
          "azureResourceGraph": {
            "query": "resources\r\n| where type =~ \"microsoft.insights/components\"\r\n| project resourceGroup"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscriptions": [
            "$sub"
          ]
        },
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "current": {
          "text": "${appinsights_name}",
          "value": "${appinsights_name}"
        },
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${am_ds}"
        },
        "definition": "",
        "label": "Application Insights",
        "name": "res",
        "options": [],
        "query": {
          "azureLogAnalytics": {
            "query": "",
            "resources": []
          },
          "namespace": "microsoft.insights/components",
          "queryType": "Azure Resource Names",
          "refId": "A",
          "resourceGroup": "$rg",
          "subscription": "$sub"
        },
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "sort": 5,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${am_ds}"
        },
        "definition": "",
        "description": "Trace Id of the agent operations",
        "hide": 2,
        "label": "Trace Id",
        "name": "mcpTraceId",
        "options": [],
        "query": {
          "azureLogAnalytics": {
            "dashboardTime": true,
            "mode": "raw",
            "query": "dependencies\r\n| distinct operation_Id\r\n| limit 50",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
            ],
            "timeColumn": "timestamp"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        },
        "refresh": 2,
        "regex": "",
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "current": {},
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${am_ds}"
        },
        "definition": "",
        "description": "Name of the mcp",
        "includeAll": true,
        "label": "MCP",
        "multi": true,
        "name": "MCPName",
        "options": [],
        "query": {
          "azureLogAnalytics": {
            "dashboardTime": true,
            "mode": "raw",
            "query": "requests\r\n| where cloud_RoleName has \"apim\"\r\n| where tostring(customDimensions[\"network.protocol.name\"]) == \"MCP\"\r\n| extend mcpname=split(name, \"/\")[1]\r\n| where isnotempty(mcpname)\r\n| summarize operationCount=count() by tostring(mcpname)\r\n| sort by operationCount desc\r\n| project mcpname",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
            ],
            "timeColumn": "timestamp"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        },
        "refresh": 2,
        "regex": "",
        "regexApplyTo": "value",
        "staticOptions": [],
        "type": "query"
      }
    ]
