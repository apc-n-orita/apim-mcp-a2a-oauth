                "query": "let MCPNames = dynamic([$MCPName]);\ntraces\n| where cloud_RoleName contains \"la-mcp\"\n| where tostring(customDimensions[\"Category\"]) == \"Workflow.Operations.Runs\"\n| where tostring(customDimensions[\"EventName\"]) == \"WorkflowRunEnd\"\n| extend p = parse_json(tostring(customDimensions[\"prop__properties\"]))\n| extend mcp = cloud_RoleName\n| where array_length(MCPNames) > 0\n| where mcp in (MCPNames)\n| where tostring(p.status) != \"Succeeded\"\n| summarize error_count = count() by bin(timestamp, $__interval)",
                "resources": [
