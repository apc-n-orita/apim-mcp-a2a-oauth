            },
            "orientation": "auto",
            "showValue": "auto",
            "stacking": "none",
            "tooltip": {
              "hideZeros": false,
              "mode": "single",
              "sort": "none"
            },
            "xField": "timestamp",
            "xTickLabelRotation": 0,
            "xTickLabelSpacing": 100
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let llm_input_per_1m = 0.25;          // Azure OpenAI: 入力 $/100万トークン (KB に割り当てたモデルの単価に合わせる)\nlet llm_output_per_1m = 2.00;         // Azure OpenAI: 出力 $/100万トークン\nlet search_reasoning_per_1m = 0.022;  // Azure AI Search: reasoning トークン $/100万 (Learn の例の仮の単価。実際は料金ページで確認)\ncustomMetrics\n| where  name startswith \"kb.\"\n| summarize input_tokens = sumif(valueSum, name == \"kb.llm_input_tokens\"),\n            output_tokens = sumif(valueSum, name == \"kb.llm_output_tokens\"),\n            reasoning_tokens = sumif(valueSum, name == \"kb.reasoning_tokens\")\n  by bin(timestamp, 1d)\n| extend openai_cost = input_tokens * llm_input_per_1m / 1000000.0 + output_tokens * llm_output_per_1m / 1000000.0,\n         search_cost = reasoning_tokens * search_reasoning_per_1m / 1000000.0\n| project timestamp,\n          [\"Azure OpenAI (LLM) cost\"] = round(openai_cost, 6),\n          [\"Azure AI Search (reasoning) cost\"] = round(search_cost, 6),\n          [\"Estimated cost\"] = round(openai_cost + search_cost, 6)",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "time_series",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Daily Cost Estimation",
          "type": "barchart"
        }
      ],
      "title": " Foundry IQ Token Usage & Cost (variable filters not applied)",
      "type": "row"
    }
  ],
  "preload": false,
  "refresh": "30m",
  "schemaVersion": 42,
  "tags": [
    "agent-framework"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Azure Monitor",
