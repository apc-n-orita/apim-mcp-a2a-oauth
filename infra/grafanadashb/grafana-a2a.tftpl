                "query": "let agentNames = dynamic([$agentName]);\r\nlet tokens = dependencies\r\n  | where name startswith \"chat \"\r\n  | summarize input_tokens = sum(toint(customDimensions[\"gen_ai.usage.input_tokens\"])),\r\n              output_tokens = sum(toint(customDimensions[\"gen_ai.usage.output_tokens\"])),\r\n              chat_calls = count()\r\n    by operation_Id;\r\ndependencies\r\n| where name contains \"invoke_agent\"\r\n| extend Agent = tostring(customDimensions[\"gen_ai.agent.name\"])\r\n| where isnotempty(Agent)\r\n| where array_length(agentNames) > 0\r\n| where Agent in (agentNames)\r\n| join kind=leftouter tokens on operation_Id\r\n| project timestamp, Agent, success, duration, input_tokens, output_tokens, chat_calls, TraceId = operation_Id\r\n| order by timestamp desc",
