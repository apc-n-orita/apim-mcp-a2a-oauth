{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Comprehensive monitoring dashboard for AI agent framework performance, tracking operations, token usage, costs, errors, and detailed trace analysis. Monitor agent health, response times, success rates, and resource consumption in real-time.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Doc",
      "tooltip": "Documentation",
      "type": "link",
      "url": "https://aka.ms/amg/dash-doc/af-agent"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${am_ds}"
      },
      "description": "Key performance indicators for agent operations including total operations executed, token consumption (input and output), and average response time across all agents.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total Operations"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total Input Tokens"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total Output Tokens"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg Response Time"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "links",
                "value": []
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {},
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "dashboardTime": true,
            "mode": "raw",
            "query": "let agentNames = dynamic([$agentName]);\ndependencies \n| where name contains \"invoke_agent\" or name startswith \"chat \"\n| extend agent_name = tostring(customDimensions[\"gen_ai.agent.name\"])\n| where isnotempty(agent_name)\n| where array_length(agentNames) > 0\n| where agent_name in (agentNames)\n| extend \n    input_tokens = toint(customDimensions[\"gen_ai.usage.input_tokens\"]),\n    output_tokens = toint(customDimensions[\"gen_ai.usage.output_tokens\"])\n| summarize \n    ['Total Operations'] = countif(name contains \"invoke_agent\"),\n    ['Total Input Tokens'] = sum(input_tokens),\n    ['Total Output Tokens'] = sum(output_tokens),\n    ['Avg Response Time'] =\n    round(avg(iif(name contains \"invoke_agent\", duration, real(null))) / 1000, 2)",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
            ],
            "resultFormat": "table",
            "timeColumn": "timestamp"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "Summary Statistics",
      "type": "stat"
    },
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 21,
      "panels": [
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Stacked time series chart showing input and output token usage trends over time, helping monitor AI model consumption and associated costs.",
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "axisColorMode": "text",
                "axisLabel": "Tokens",
                "axisPlacement": "auto",
                "barAlignment": 0,
                "barWidthFactor": 0.6,
                "drawStyle": "line",
                "fillOpacity": 25,
                "gradientMode": "none",
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                },
                "insertNulls": false,
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "pointSize": 5,
                "scaleDistribution": {
                  "type": "linear"
                },
                "showPoints": "never",
                "showValues": false,
                "spanNulls": false,
                "stacking": {
                  "group": "A",
                  "mode": "normal"
                },
                "thresholdsStyle": {
                  "mode": "off"
                }
              },
              "links": [],
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  }
                ]
              },
              "unit": "short"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Input Tokens"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "fixedColor": "blue",
                      "mode": "fixed"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Output Tokens"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "fixedColor": "green",
                      "mode": "fixed"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 8,
            "w": 10,
            "x": 0,
            "y": 6
          },
          "id": 4,
          "interval": "1h",
          "maxDataPoints": 50,
          "options": {
            "legend": {
              "calcs": [
                "sum"
              ],
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "hideZeros": false,
              "mode": "multi",
              "sort": "none"
            }
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let agentNames = dynamic([$agentName]);\ndependencies \n| where name startswith \"chat \"\n| extend agent_name = tostring(customDimensions[\"gen_ai.agent.name\"])\n| where isnotempty(agent_name)\n| where array_length(agentNames) > 0\n| where agent_name in (agentNames)\n| extend \n    input_tokens = toint(customDimensions[\"gen_ai.usage.input_tokens\"]),\n    output_tokens = toint(customDimensions[\"gen_ai.usage.output_tokens\"])\n| summarize \n    ['Input Tokens'] = sum(input_tokens),\n    ['Output Tokens'] = sum(output_tokens)\n    by bin(timestamp, $__interval)",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "time_series",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Token Consumption Over Time",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Donut chart showing the distribution of total token consumption (input + output) across different agents, helping identify which agents consume the most resources.",
          "fieldConfig": {
            "defaults": {
              "color": {
                "fixedColor": "#73BF69",
                "mode": "palette-classic"
              },
              "custom": {
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                }
              },
              "links": [],
              "mappings": [],
              "unit": "short"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 8,
            "w": 7,
            "x": 10,
            "y": 6
          },
          "id": 5,
          "options": {
            "displayLabels": [
              "percent"
            ],
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "showLegend": true,
              "values": [
                "value"
              ]
            },
            "pieType": "donut",
            "reduceOptions": {
              "calcs": [],
              "fields": "",
              "values": true
            },
            "sort": "desc",
            "tooltip": {
              "hideZeros": false,
              "mode": "single",
              "sort": "none"
            }
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let agentNames = dynamic([$agentName]);\ndependencies \n| where name startswith \"chat \"\n| extend agent_name = tostring(customDimensions[\"gen_ai.agent.name\"])\n| where isnotempty(agent_name)\n| where array_length(agentNames) > 0\n| where agent_name in (agentNames)\n| extend \n    input_tokens = toint(customDimensions[\"gen_ai.usage.input_tokens\"]),\n    output_tokens = toint(customDimensions[\"gen_ai.usage.output_tokens\"])\n| summarize \n    total_tokens = sum(input_tokens + output_tokens)\n    by agent_name",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "table",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Token Usage by Agent",
          "type": "piechart"
        },
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Bar chart estimating daily operational costs based on token consumption and model pricing. Rates are configurable in the query (example: $1.25 per 1M input tokens, $10 per 1M output tokens).",
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "continuous-blues"
              },
              "custom": {
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "axisColorMode": "text",
                "axisLabel": "Cost ($)",
                "axisPlacement": "auto",
                "fillOpacity": 80,
                "gradientMode": "none",
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                },
                "lineWidth": 1,
                "scaleDistribution": {
                  "type": "linear"
                },
                "thresholdsStyle": {
                  "mode": "off"
                }
              },
              "links": [],
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  }
                ]
              },
              "unit": "currencyUSD"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 8,
            "w": 7,
            "x": 17,
            "y": 6
          },
          "id": 6,
          "options": {
            "barRadius": 0,
            "barWidth": 0.97,
            "colorByField": "estimated_cost",
            "fullHighlight": false,
            "groupWidth": 0.7,
            "legend": {
              "calcs": [
                "sum"
              ],
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "orientation": "auto",
            "showValue": "auto",
            "stacking": "none",
            "tooltip": {
              "hideZeros": false,
              "mode": "single",
              "sort": "none"
            },
            "xTickLabelRotation": 0,
            "xTickLabelSpacing": 100
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "let agentNames = dynamic([$agentName]);\ndependencies \n| where name startswith \"chat \"\n| extend agent_name = tostring(customDimensions[\"gen_ai.agent.name\"])\n| where isnotempty(agent_name)\n| where array_length(agentNames) > 0\n| where agent_name in (agentNames)\n| extend \n    input_tokens = toint(customDimensions[\"gen_ai.usage.input_tokens\"]),\n    output_tokens = toint(customDimensions[\"gen_ai.usage.output_tokens\"]),\n    cached_input_tokens = toint(customDimensions[\"gen_ai.usage.cache_read.input_tokens\"])\n| extend uncached_input_tokens = input_tokens - coalesce(cached_input_tokens, 0)\n| extend\n    // Adjust per-model rates. Defaults below are GPT-5 mini-class. Cached input is ~1/10 of uncached.\n    uncached_cost = uncached_input_tokens * 0.00000025,        // $0.25 per 1M uncached input\n    cached_cost   = coalesce(cached_input_tokens, 0) * 0.000000025, // $0.025 per 1M cached input\n    output_cost   = output_tokens * 0.000002                   // $2 per 1M output\n| summarize estimated_cost = sum(uncached_cost + cached_cost + output_cost) by bin(timestamp, 1d)\n| order by timestamp asc",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "time_series",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Daily Cost Estimation",
          "type": "barchart"
        }
      ],
      "title": "Token Usage & Cost Analysis",
      "type": "row"
    },
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 30,
      "panels": [
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Percentage of input tokens served from cache across LLM chat calls (gen_ai.operation.name == 'chat'). Cached input is ~1/10 the price of uncached, so a high hit rate directly reduces spend.",
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "links": [],
              "mappings": [],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "light-green",
                    "value": 0
                  },
                  {
                    "color": "green",
                    "value": 30
                  },
                  {
                    "color": "dark-green",
                    "value": 70
                  }
                ]
              },
              "unit": "percent"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 0,
            "y": 70
          },
          "id": 31,
          "options": {
            "barShape": "flat",
            "barWidthFactor": 0.5,
            "effects": {
              "barGlow": false,
              "centerGlow": false,
              "gradient": false
            },
            "endpointMarker": "point",
            "minVizHeight": 75,
            "minVizWidth": 75,
            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "segmentCount": 1,
            "segmentSpacing": 0.3,
            "shape": "gauge",
            "showThresholdLabels": false,
            "showThresholdMarkers": true,
            "sizing": "auto",
            "sparkline": false,
            "textMode": "auto"
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "dependencies\n| extend op_name = tostring(customDimensions[\"gen_ai.operation.name\"])\n| where op_name == \"chat\"\n| where tostring(customDimensions[\"gen_ai.agent.name\"]) !startswith \"github-copilot-\"\n| extend in_tok = toint(customDimensions[\"gen_ai.usage.input_tokens\"]),\n         cache_tok = toint(customDimensions[\"gen_ai.usage.cache_read.input_tokens\"])\n| summarize cache_hit_pct = round(sum(cache_tok) * 100.0 / sum(in_tok), 1)",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "table",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Cache Hit Rate (chat)",
          "type": "gauge"
        },
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Total input tokens served from prompt cache. Equivalent to ~90% of these tokens' uncached cost saved.",
          "fieldConfig": {
            "defaults": {
              "color": {
                "fixedColor": "blue",
                "mode": "fixed"
              },
              "links": [],
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "blue",
                    "value": 0
                  }
                ]
              },
              "unit": "short"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 6,
            "w": 6,
            "x": 6,
            "y": 70
          },
          "id": 32,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "center",
            "orientation": "auto",
            "percentChangeColorMode": "standard",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "showPercentChange": false,
            "textMode": "value_and_name",
            "wideLayout": true
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "dependencies\n| extend op_name = tostring(customDimensions[\"gen_ai.operation.name\"])\n| where op_name == \"chat\"\n| where tostring(customDimensions[\"gen_ai.agent.name\"]) !startswith \"github-copilot-\"\n| extend cache_tok = toint(customDimensions[\"gen_ai.usage.cache_read.input_tokens\"])\n| summarize ['Tokens From Cache'] = sum(cache_tok)",
                "resources": [
                  "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$res"
                ],
                "resultFormat": "table",
                "timeColumn": "timestamp"
              },
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "$${am_ds}"
              },
              "queryType": "Azure Log Analytics",
              "refId": "A"
            }
          ],
          "title": "Tokens From Cache (chat)",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${am_ds}"
          },
          "description": "Distribution of LLM chat finish reasons. Common values: tool_calls (multi-step agent step), stop (completion), length (hit max_tokens), content_filter (safety).",
          "fieldConfig": {
            "defaults": {
              "color": {
                "fixedColor": "#73BF69",
                "mode": "palette-classic"
              },
              "custom": {
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                }
              },
              "links": [],
              "mappings": [],
              "unit": "short"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".*"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": []
                  }
                ]
              }
            ]
          },
          "gridPos": {
            "h": 6,
            "w": 12,
            "x": 12,
            "y": 70
          },
          "id": 33,
          "options": {
            "displayLabels": [
              "percent"
            ],
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "showLegend": true,
              "values": [
                "value"
              ]
            },
            "pieType": "donut",
            "reduceOptions": {
              "calcs": [],
              "fields": "",
              "values": true
            },
            "sort": "desc",
            "tooltip": {
              "hideZeros": false,
              "mode": "single",
              "sort": "none"
            }
          },
          "pluginVersion": "13.2.0",
          "targets": [
            {
              "azureLogAnalytics": {
                "dashboardTime": true,
                "mode": "raw",
                "query": "dependencies\n| extend op_name = tostring(customDimensions[\"gen_ai.operation.name\"]),\n         finish = tostring(customDimensions[\"gen_ai.response.finish_reasons\"])\n| where op_name == \"chat\"\n| where tostring(customDimensions[\"gen_ai.agent.name\"]) !startswith \"github-copilot-\"\n| where isnotempty(finish)\n| summarize call_count = count() by finish",
                "resources": [
